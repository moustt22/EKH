ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://ekh:ekh@postgres:5432/ekh
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=ekh_chunks
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=ekh
MINIO_SECRET_KEY=ekhsecret
MINIO_BUCKET=ekh-documents
MINIO_SECURE=false
MINIO_REGION=
JWT_SECRET=change-me-before-any-shared-deployment
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=openrouter/free
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
EMBED_DIM=1536
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ekh
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Neon: set DATABASE_URL to the Neon string and keep the postgresql+psycopg prefix.
# Add ?sslmode=require. Example:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require
#
# Backblaze B2: create a private bucket, then an application key that can use it.
# MINIO_ENDPOINT=s3.us-west-004.backblazeb2.com
# MINIO_ACCESS_KEY=the keyID
# MINIO_SECRET_KEY=the applicationKey
# MINIO_BUCKET=ekh-documents
# MINIO_SECURE=true
# MINIO_REGION=us-west-004
